EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=contacto@maxservicesspa.cl
EMAIL_HOST_PASSWORD=app_password_de_google_sin_espacios
DEFAULT_FROM_EMAIL=contacto@maxservicesspa.cl
CONTACT_EMAIL=contacto@maxservicesspa.cl
SITE_URL=http://127.0.0.1:8000
EMAIL_BRAND_LOGO_URL=

# Medicion (opcionales). Sin valor no se carga ningun script.
# GA4_MEASUREMENT_ID: lo entrega Google Analytics, con formato G-XXXXXXXXXX
GA4_MEASUREMENT_ID=
# GOOGLE_SITE_VERIFICATION: el codigo del metodo "etiqueta HTML" de Search Console
GOOGLE_SITE_VERIFICATION=

# Seguridad. En produccion (Render) estas dos son obligatorias:
# DJANGO_SECRET_KEY: cadena larga y aleatoria. La que estaba escrita en el
#   codigo quedo publicada en el historial del repo: hay que reemplazarla.
DJANGO_SECRET_KEY=
# DJANGO_DEBUG: se deja VACIO o en False en produccion. Con DEBUG encendido
#   cualquier error muestra la traza con las variables de entorno.
DJANGO_DEBUG=True
